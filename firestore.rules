rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Helper function to check if user is signed in
    function isSignedIn() {
      return request.auth != null;
    }

    // Helper function to check if user is an administrator
    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.keys().hasAll(['admin']) && request.auth.token.admin == true)
      );
    }

    // Admins Collection
    // An admin can read admin list. First-time admin setup allows creation of own record.
    match /admins/{adminId} {
      allow read: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
      allow write: if isSignedIn() && (request.auth.uid == adminId || isAdmin());
    }

    // Products Collection
    // Public can read all active products; Only verified admins can create, update, or delete.
    match /products/{productId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Categories Collection
    // Public can read categories; Only verified admins can manage categories.
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Blogs Collection
    // Public can read published blog articles; Only verified admins can manage blogs.
    match /blogs/{blogId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Testimonials Collection
    // Public can read testimonials; Only verified admins can manage testimonials.
    match /testimonials/{testimonialId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Website Content Collection (Settings, banners, text)
    // Public can read content configuration; Only verified admins can update content.
    match /websiteContent/{contentId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Orders Collection
    // Customers and admins can read/write orders appropriately.
    match /orders/{orderId} {
      allow read, write: if isAdmin();
      allow create: if true; // Public checkout creates an order
    }

    // Customers Collection
    // Protected customer data accessible by admins.
    match /customers/{customerId} {
      allow read, write: if isAdmin();
    }
  }
}
